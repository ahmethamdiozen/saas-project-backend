# Local docker-compose environment
# DATABASE_URL and REDIS_URL are overridden by docker-compose.yml automatically

ENVIRONMENT=development
SECRET_KEY=local-dev-secret-key-change-in-production

# OpenAI (required — add your real key)
OPENAI_API_KEY=sk-proj-...

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Email — leave blank to disable emails locally
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@localhost
EMAILS_FROM_NAME=SaaS Platform

# Vector DB — disabled locally by default (uses ChromaDB instead)
USE_PINECONE=False

# Storage — disabled locally by default (uses local filesystem instead)
USE_S3=False
